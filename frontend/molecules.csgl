const {
  H_ATOM_R = 0.04;
  O_ATOM_R = H_ATOM_R * 1.3 * 1.1;
  C_ATOM_R = O_ATOM_R;
  P_ATOM_R = C_ATOM_R * 1.1;
}


// Atoms
let hydrogenAtom = color(Sphere(H_ATOM_R), 255, 255, 255);
let oxygenAtom = color(Sphere(O_ATOM_R), 215, 0, 0);
let carbonAtom = color(Sphere(C_ATOM_R), 0, 0, 0);
let phosphorusAtom = color(Sphere(P_ATOM_R), 255, 255, 0);



let empty = difference(Sphere(5), Sphere(7));


// Molecules


let h20 = union(
  union(
    translate(hydrogenAtom, -0.035, 0.025, 0),
    translate(hydrogenAtom, 0.035, 0.025, 0)
  ),
  oxygenAtom
);

let phosphate = union(
  union(union(union(
        translate(oxygenAtom, -.04, -.04, -.03), translate(oxygenAtom, .03, -.04, -.03)
      ),
      translate(oxygenAtom, 0, -.04, .04)),
    translate(oxygenAtom, 0, .04, 0)),
  phosphorusAtom
);

let carbonHydrogen = union(carbonAtom, translate(hydrogenAtom, 0, .055, 0));
let carbonDihydrogen = union(union(
    translate(hydrogenAtom, -0.035, 0.025, 0),
    translate(hydrogenAtom, 0.035, 0.025, 0)
  ), carbonAtom
);
let oxyHydrogen = union(oxygenAtom, translate(hydrogenAtom, 0, .055, 0));

let deoxyribose = union(
  union(
    union(
      union(translate(carbonHydrogen, -.03, -.04, 0), translate(carbonDihydrogen, .03, -.04, 0)), // 2' and 3'
      translate(rotate(carbonHydrogen, .03, 0, 0), 45, 45, 0) // 1'
    ),
    // union(carbonHydrogen, carbonDihydrogen) // 4' and 5'
    empty
  ), empty // oxygenAtom
);
Render(deoxyribose);