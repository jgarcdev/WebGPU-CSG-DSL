// Sample CSG script demonstrating primitives, transforms, and operations

let cube = color(Cube(1), 0, 255, 255);
let sphere = color(Sphere(0.65), 255, 255, 0);
let cs = intersection(cube, sphere);


let c0 = color(Cylinder(0.35, 1.01), 255, 0, 255);
let c1 = rotate(
  color(Cylinder(0.35, 1.01), 0, 255, 0),
  0, 0, 90
);
let c0c1 = union(c0, c1);

let c2 = rotate(
  color(Cylinder(0.35, 1.01), 255, 0, 0),
  90, 0, 0
);
let c = union(c0c1, c2);


let shape = difference(cs, c);
Render(shape);